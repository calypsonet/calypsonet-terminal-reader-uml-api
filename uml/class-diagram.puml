    *** <back:#E9F7EF><color:#27AE60><b>Data, constants, enumeration or error
end legend

package "reader" as reader {

class "ReaderApiProperties" as ApiProperties <<constants>> <<green>> {
    +const VERSION: String = "3.0"
}
interface "ReaderApiFactory" as ReaderApiFactory <<blue>> {
    +<color:blue>getCardReaderProvider() → CardReaderProvider

    +<color:blue>createSingleCardSelectionManager() → SingleCardSelectionManager
    +<color:blue>createMultipleCardSelectionManager() → MultipleCardSelectionManager
    +<color:blue>createMultichannelCardSelectionManager() → MultichannelCardSelectionManager
}

interface "<color:blue>CardReaderProvider" as CardReaderProvider <<blue>> {
    +<color:blue>getReaderNames() → Set<String>
    +<color:blue>getReaders() → Set<CardReader>
    +<color:blue>getReader(readerName: String) → CardReader?
    +<color:blue>findReader(readerNameRegex: String) → CardReader?
}

' SERVICE
interface CardReader {
    +getName() → String
    +isContactless() → Boolean

    +isCardPresent() → Boolean
    {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderCommunication</color></size>
}
interface "ObservableCardReader" as ObservableCardReader extends CardReader {
    +<color:blue>startCardDetection(settings: CardDetectionSettings, eventHandler: CardReaderEventHandler) → Unit
    +stopCardDetection() → Unit

    +<color:blue>endCardProcessing() → Unit
}
class "<color:blue>CardDetectionSettings" as CardDetectionSettings <<data>> <<green>> {
    +<color:blue>val detectionMode: DetectionMode = DetectionMode.REPEATING
    +{field} <color:blue>val rfTechnologies: Set<<back:yellow>RfTechnology</back>> = setOf(<back:yellow>RfTechnology.ISO_14443_AB</back>)
    +{field} <color:blue>val ecpFrame: ByteArray? = null
}
enum DetectionMode <<green>> {
    +REPEATING
    +<color:blue>SINGLE_SHOT
}
class "CardReaderEvent" as CardReaderEvent <<data>> <<green>> {
    +val readerName: String
    +val type: CardReaderEventType
    +val scheduledCardSelectionsResponse: ScheduledCardSelectionsResponse?
}
enum "<color:blue>CardReaderEventType" as CardReaderEventType <<green>> {
    +CARD_INSERTED
    +CARD_MATCHED
    +CARD_REMOVED
    +<color:blue>READER_UNREGISTERED
}
' SPI
package "spi" as readerSpi {
    interface "<color:blue>CardReaderEventHandler" as CardReaderEventHandler <<red>> {
        +<color:blue>onReaderEvent(cardReaderEvent: CardReaderEvent) → Unit
        +<color:blue>onReaderError(context: String, readerName: String, error: Any) → Unit
    }
}

' SELECTION
package "selection" as selectionApi {
    ' Selection
    interface CardSelectionManager {
        +<color:blue>prepareSelection(selectionId: Int, cardSelector: CardSelector, cardSelectionExtension: CardSelectionExtension) → Self

        +exportCardSelectionScenario() → String
        +<color:blue>importCardSelectionScenario(cardSelectionScenario: String) → Self

        +exportProcessedCardSelectionScenario() → String
    }
    interface "<color:blue>SingleCardSelectionManager" as SingleCardSelectionManager <<blue>> extends CardSelectionManager {
        +<color:blue>processCardSelectionScenario(reader: CardReader) → SingleCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderCommunication, CardCommunication, InvalidCardResponse</color></size>

        +<color:blue>scheduleCardSelectionScenario(observableCardReader: ObservableCardReader, cardPresenceNotificationPolicy: CardPresenceNotificationPolicy) → Unit
        +<color:blue>parseScheduledCardSelectionsResponse(scheduledCardSelectionsResponse: ScheduledCardSelectionsResponse) → SingleCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: InvalidCardResponse</color></size>

        +<color:blue>importProcessedCardSelectionScenario(processedCardSelectionScenario: String) → SingleCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: InvalidCardResponse</color></size>
    }
    interface "<color:blue>MultipleCardSelectionManager" as MultipleCardSelectionManager <<blue>> extends CardSelectionManager {
        +<color:blue>processCardSelectionScenario(reader: CardReader) → MultipleCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderCommunication, CardCommunication, InvalidCardResponse</color></size>

        +<color:blue>scheduleCardSelectionScenario(observableCardReader: ObservableCardReader, cardPresenceNotificationPolicy: CardPresenceNotificationPolicy) → Unit
        +<color:blue>parseScheduledCardSelectionsResponse(scheduledCardSelectionsResponse: ScheduledCardSelectionsResponse) → MultipleCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: InvalidCardResponse</color></size>

        +<color:blue>importProcessedCardSelectionScenario(processedCardSelectionScenario: String) → MultipleCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: InvalidCardResponse</color></size>
    }
    interface "<color:blue>MultichannelCardSelectionManager" as MultichannelCardSelectionManager <<blue>> extends CardSelectionManager {
        +<color:blue>processCardSelectionScenario(reader: CardReader, channelSelectionPolicy: ChannelSelectionPolicy) → MultichannelCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderCommunication, CardCommunication, InvalidCardResponse</color></size>

        +<color:blue>importProcessedCardSelectionScenario(processedCardSelectionScenario: String) → MultichannelCardSelectionResult
        {method} <size:10><color:#7F8C8D>    ⚠ errors: InvalidCardResponse</color></size>
    }
    enum "<color:blue>CardPresenceNotificationPolicy" as CardPresenceNotificationPolicy <<green>> {
        +<color:blue>ALWAYS
        +<color:blue>MATCHED_ONLY
    }
    enum "<color:blue>ChannelSelectionPolicy" as ChannelSelectionPolicy <<green>> {
        +<color:blue>ALLOW_BASIC_CHANNEL
        +<color:blue>LOGICAL_CHANNEL_ONLY
    }
    interface "CardSelector" as CardSelector <<sealed>> {
    }
    class "BasicCardSelector" as BasicCardSelector <<data>> <<green>> implements CardSelector {
        +<color:blue>val cardType: <back:yellow>CardType</back>? = null
        +val powerOnDataRegex: String? = null
    }
    class "IsoCardSelector" as IsoCardSelector <<data>> <<green>> implements CardSelector {
        +<color:blue>val cardType: <back:yellow>CardType</back>? = null
        +val powerOnDataRegex: String? = null
        +val dfName: ByteArray? = null
        +val fileOccurrence: FileOccurrence = FileOccurrence.FIRST
        +val fileControlInformation: FileControlInformation = FileControlInformation.FCI
    }
    enum "FileOccurrence" as FileOccurrence <<green>> {
        +FIRST
        +LAST
        +NEXT
        +PREVIOUS
    }
    enum "FileControlInformation" as FileControlInformation <<green>> {
        +FCI
        +FCP
        +FMD
        +NO_RESPONSE
    }

    ' Card Extension SPI
    package "spi" as selectionSpi {
        interface "CardSelectionExtension" as CardSelectionExtension <<red>> {
        }
        interface "SmartCard" as SmartCard <<red>> {
            +getPowerOnData() → String?
            +<color:blue>isActive() → Boolean
        }
        interface "IsoSmartCard" as IsoSmartCard <<red>> extends SmartCard {
            +getSelectApplicationResponse() → ByteArray?
            +<color:blue>isBasicChannel() → Boolean
        }
    }
    class "<color:blue>SingleCardSelectionResult" as SingleCardSelectionResult <<data>> <<green>> {
        +<color:blue>val cardType: <back:yellow>CardType</back>
        +<color:blue>val selectionId: Int?
        +<color:blue>val smartCard: SmartCard?
    }
    class "<color:blue>MultipleCardSelectionResult" as MultipleCardSelectionResult <<data>> <<green>> {
        +<color:blue>val cardType: <back:yellow>CardType</back>
        +<color:blue>val smartCards: Map<Int, SmartCard>
        +<color:blue>val activeSelectionId: Int?
    }
    class "<color:blue>MultichannelCardSelectionResult" as MultichannelCardSelectionResult <<data>> <<green>> {
        +<color:blue>val cardType: <back:yellow>CardType</back>
        +<color:blue>val smartCards: Map<Int, SmartCard>
    }
    interface ScheduledCardSelectionsResponse {
    }
}

' TRANSACTION
package "transaction" as transactionApi {
    package "spi" as transactionSpi {
        interface "CardTransactionManager" as CardTransactionManager <<red>> {
            +<color:blue>processCommands() → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderCommunication, CardCommunication, InvalidCardResponse</color></size>
        }
        interface "<color:blue>IsoCardTransactionManager" as IsoCardTransactionManager <<red>> extends CardTransactionManager {
            +<color:blue>asMultichannelCardTransactionManager() → MultichannelCardTransactionManager
        }
        interface "<color:blue>MultichannelCardTransactionManager" as MultichannelCardTransactionManager <<red>> extends CardTransactionManager {
            +<color:blue>processCommandsAndCloseChannel() → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderCommunication, CardCommunication, InvalidCardResponse</color></size>
            +<color:blue>closeChannel() → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderCommunication, CardCommunication</color></size>
        }
    }
}

' Errors
exception "ReaderCommunication\nCardCommunication\nInvalidCardResponse" as errors <<error>> <<green>> {
    +val message: String
    +val cause: Any?
}

}

